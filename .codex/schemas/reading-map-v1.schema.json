{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-residual.invalid/schemas/r2/reading-map-v1.schema.json",
  "title": "R2 Progressive Disclosure Reading Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "mode",
    "milestone",
    "batch_id",
    "source_commit",
    "source_tree",
    "generated_at",
    "context_budget",
    "documents",
    "forbidden_bulk_reads",
    "binding_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "mode": {
      "enum": [
        "PLAN",
        "IMPLEMENT",
        "ACCEPT",
        "REPAIR"
      ]
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^M[0-9]+-B[0-9]{3,}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "planned_bytes",
        "ratio",
        "soft_limit",
        "hard_limit",
        "status"
      ],
      "properties": {
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "planned_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0
        },
        "soft_limit": {
          "const": 0.55
        },
        "hard_limit": {
          "const": 0.7
        },
        "status": {
          "enum": [
            "OK",
            "SOFT_REDUCED",
            "HARD_BLOCKED"
          ]
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sections",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "forbidden_bulk_reads": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
