{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-residue.schema/scenario/0.1",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "keeper_truth",
    "scenes",
    "npcs",
    "clues",
    "timeline",
    "threats",
    "endings",
    "safety_notes",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "const": "rules-residue.scenario/0.1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "classification",
        "recommended_players",
        "gm_modes",
        "quick_mode_safe",
        "entry_scene_id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rr\\.[a-z0-9._-]+$"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "tutorial",
            "golden",
            "scenario"
          ]
        },
        "recommended_players": {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "additionalProperties": false
        },
        "gm_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "human",
              "ai"
            ]
          },
          "uniqueItems": true
        },
        "quick_mode_safe": {
          "const": true
        },
        "entry_scene_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "keeper_truth": {
      "type": "object",
      "required": [
        "premise",
        "immutable_facts"
      ],
      "properties": {
        "premise": {
          "type": "string"
        },
        "immutable_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "visibility"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "visibility": {
                "const": "gm_only"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "critical_path",
          "exits",
          "action_targets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "critical_path": {
            "type": "boolean"
          },
          "exits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "action_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "public_description",
          "private_truth",
          "initial_intent"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "public_description": {
            "type": "string"
          },
          "private_truth": {
            "type": "string"
          },
          "initial_intent": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "clues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fact_id",
          "text",
          "source_scene_id",
          "critical",
          "visibility",
          "failure_fallback"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fact_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_scene_id": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "visibility": {
            "type": "string"
          },
          "failure_fallback": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "initial",
          "maximum"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "initial": {
            "type": "integer",
            "minimum": 0
          },
          "maximum": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "condition",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": true
          },
          "critical": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "object",
      "required": [
        "default",
        "gm_only_fields"
      ],
      "properties": {
        "default": {
          "const": "public"
        },
        "gm_only_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
