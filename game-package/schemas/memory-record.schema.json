{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-residue.schema/memory-record/0.1",
  "type": "object",
  "required": [
    "schema_version",
    "memory_id",
    "subject_id",
    "statement",
    "source_event_ids",
    "visibility",
    "confidence",
    "created_at_event_index",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "rules-residue.memory-record/0.1"
    },
    "memory_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "visibility": {
      "type": "string",
      "pattern": "^(public|gm_only|participant:[a-zA-Z0-9._:-]+|team:[a-zA-Z0-9._:-]+|agent:[a-zA-Z0-9._:-]+)$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "inferred"
      ]
    },
    "created_at_event_index": {
      "type": "integer",
      "minimum": 0
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
