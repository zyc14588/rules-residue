{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-residue.schema/package-lock/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "algorithm",
    "runtime_tree_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "rules-residue.package-lock/1.0"
    },
    "package_id": {
      "const": "org.trpgplatform.rules-residue"
    },
    "package_version": {
      "type": "string"
    },
    "algorithm": {
      "const": "sha256"
    },
    "runtime_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
