{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-residue.schema/expected-path/0.1",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "rules-residue.expected-path/0.1"
    },
    "module_id": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "rule_input",
          "resolution_input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "additionalProperties": true
          },
          "rule_input": {
            "type": "object",
            "additionalProperties": true
          },
          "resolution_input": {
            "type": "object",
            "additionalProperties": true
          },
          "expected": {
            "type": "object",
            "required": [
              "plan_kind",
              "outcome",
              "effect_types"
            ],
            "properties": {
              "plan_kind": {
                "enum": [
                  "roll",
                  "resource_spend"
                ]
              },
              "outcome": {
                "type": "string"
              },
              "effect_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
