                "gate_id": {"const": "EXT-CREATOR-EXTENSIONS"},
                "execution_status": {"const": "BLOCKED_EXTERNAL"},
                "blocking_probe_ids": {"const": ["R2-INT-006"]}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate_id", "execution_status", "blocking_probe_ids"],
              "properties": {
                "gate_id": {"const": "EXT-RUNTIME-SAFETY"},
                "execution_status": {"const": "BLOCKED_EXTERNAL"},
                "blocking_probe_ids": {"const": ["R2-INT-011", "R2-INT-012"]}
              }
            }
          ],
          "items": false,
          "minItems": 2
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["M2-B002_READY", "M2-B002", "blocking_ids"],
