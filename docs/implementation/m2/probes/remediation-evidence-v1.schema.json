      "required": ["target", "repository", "commit", "tree"],
      "properties": {
        "target": {"const": "A:rules-residue"},
        "repository": {"const": "rules-residue"},
        "commit": {"const": "c6a840b10db46dc475cd9af9e6a1a13f1e68abd4"},
