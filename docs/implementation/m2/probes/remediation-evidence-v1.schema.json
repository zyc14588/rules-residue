            "M2-B002_READY": {"const": "NO"},
            "M2-B002": {"const": "NOT_STARTED"},
            "blocking_ids": {"const": ["R2-INT-011", "R2-INT-012", "DEFER-R2-C14-001"]}
          }
        }
      }
    },
    "integrity_classes": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/integrity_f001"},
        {"$ref": "#/$defs/integrity_f002"}
      ],
      "items": false,
      "minItems": 2
    }
