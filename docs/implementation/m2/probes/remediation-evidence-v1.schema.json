    "evidence_id",
    "nature",
    "task_id",
    "previous_status",
    "new_status",
    "classification",
    "transition_reason",
    "previous_evidence",
    "formal_semantics",
    "route_binding",
    "antecedents",
    "exact_target_pair",
    "creator_tool",
    "evidence_links",
    "phase_results",
    "non_claims",
    "projections",
    "integrity_classes"
  ],
  "properties": {
    "schema_version": {"const": "rules-residue.m2.remediation-evidence/1.0"},
    "evidence_id": {"const": "R2-INT-010-REM-001-J001"},
    "nature": {"const": "ADDITIVE_REMEDIATION_EVIDENCE"},
    "task_id": {"const": "R2-INT-010-REM-001"},
    "previous_status": {"const": "FAIL"},
    "new_status": {"const": "RESOLVED_ADAPTER"},
    "classification": {"const": "R2_COMPATIBILITY_ADAPTER"},
    "transition_reason": {"const": "Exact cross-repository execution proves that the approved generic namespaced JSON extension path preserves and round-trips the rules-residue probe through Host and Creator Tool, resolving R2-INT-010 as an adapter without claiming formal M2-B002, formal M2-B009, or aggregate readiness."},
    "previous_evidence": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/previous_probe_result"},
        {"$ref": "#/$defs/previous_ext_supplement"},
        {"$ref": "#/$defs/previous_ext_manifest"}
      ],
      "items": false,
      "minItems": 3
    },
    "formal_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_B002", "formal_B009"],
      "properties": {
        "formal_B002": {"const": false},
        "formal_B009": {"const": false}
      }
    },
    "route_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "mode", "milestone", "batch_id", "source_commit", "source_tree", "binding_digest", "freshness_status"],
      "properties": {
        "route_id": {"const": "R2-INT-010-REM-001-EVIDENCE-IMPLEMENT"},
        "mode": {"const": "IMPLEMENT"},
        "milestone": {"const": "M1"},
        "batch_id": {"const": "M1-B010"},
        "source_commit": {"const": "c6a840b10db46dc475cd9af9e6a1a13f1e68abd4"},
        "source_tree": {"const": "cfb11378935d4b2bf380a6505e87589c18b1eaa2"},
        "binding_digest": {"const": "0f60912817903a926e07bd7e11d6b66402d5676c2aa45ee0faa4485db70b81e6"},
        "freshness_status": {"const": "PASS"}
      }
    },
    "antecedents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_change_proposal", "owner_governance_approval_candidate"],
      "properties": {
        "platform_change_proposal": {"$ref": "#/$defs/proposal_antecedent"},
        "owner_governance_approval_candidate": {"$ref": "#/$defs/approval_antecedent"}
      }
    },
    "exact_target_pair": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/rules_target"},
        {"$ref": "#/$defs/platform_target"}
