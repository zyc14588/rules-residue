    "phase_results": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/phase_e001"},
        {"$ref": "#/$defs/phase_e002"},
        {"$ref": "#/$defs/phase_e003"},
        {"$ref": "#/$defs/phase_e004"},
        {"$ref": "#/$defs/phase_e005"},
        {"$ref": "#/$defs/phase_e006"},
        {"$ref": "#/$defs/phase_e007"}
