      "items": false,
      "minItems": 2
    },
    "creator_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_commit", "platform_tree", "binary_version", "build_command", "binary_sha256"],
      "properties": {
        "platform_commit": {"const": "1339c490bd8cae1e2a6e6607fc0f1db019faab64"},
        "platform_tree": {"const": "25d5645caf883a73f165db0179accbca48ddf526"},
        "binary_version": {"const": "0.1.0-m1"},
        "build_command": {"const": "argv-v1:pnpm|--dir|apps/creator-studio/frontend|build||go|build|-trimpath|-buildvcs=false|-tags|production,webkit2_41|-o|<CREATOR_BINARY>|./apps/creator-studio"},
        "binary_sha256": {"const": "7e31836febd753ca32dc0b81d9f9d8fc7c15fee123730fc4998ca1ee30b7e3a2"}
      }
    },
