{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-residual.invalid/schemas/r2/content-provenance-v1.schema.json",
  "title": "R2 Content Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "object_type",
    "author",
    "modifiers",
    "reviewers",
    "mechanical_consistency_status",
    "content_version",
    "approval_version",
    "safety_checks",
    "source_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "object_type": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "mechanical_consistency_status": {
      "enum": [
        "NOT_CHECKED",
        "CHECKING",
        "FAIL",
        "CONDITIONAL_PASS",
        "PASS",
        "SUPERSEDED"
      ]
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "approval_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "safety_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "policy_id",
          "result",
          "checked_at",
          "checker"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "policy_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
            "minLength": 3,
            "maxLength": 128
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "checker": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
