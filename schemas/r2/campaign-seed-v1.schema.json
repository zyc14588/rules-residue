{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-residual.invalid/schemas/r2/campaign-seed-v1.schema.json",
  "title": "R2 Immutable Campaign Seed Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_seed_id",
    "generated_at",
    "content_version_digest",
    "immutable_after_start",
    "regions",
    "document_mappings",
    "npc_local_identities",
    "faction_relationships",
    "anchor_conditions",
    "skip_route_conditions",
    "endgame_sources",
    "boss_persona_order",
    "calibration_combination",
    "return_coordinates",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "campaign_seed_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_version_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "immutable_after_start": {
      "const": true
    },
    "regions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "document_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "npc_local_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "faction_relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "anchor_conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "skip_route_conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "endgame_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "boss_persona_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "calibration_combination": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "return_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "source_component_id"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "value": {},
        "source_component_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
          "minLength": 3,
          "maxLength": 128
        }
      }
    }
  }
}
