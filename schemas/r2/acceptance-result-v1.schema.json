{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-residual.invalid/schemas/r2/acceptance-result-v1.schema.json",
  "title": "R2 Strict Acceptance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "target",
    "candidate_commit",
    "candidate_tree",
    "result",
    "executed_checks",
    "findings",
    "source_unchanged",
    "verifier_modified_files",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_EXTERNAL",
        "BLOCKED_ENVIRONMENT",
        "BLOCKED_DESIGN_CONFLICT"
      ]
    },
    "executed_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "command",
          "exit_code",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
            "minLength": 3,
            "maxLength": 128
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "location",
          "reproduction",
          "violated_requirement",
          "expected",
          "actual",
          "repair_boundary",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
            "minLength": 3,
            "maxLength": 128
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "reproduction": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "violated_requirement": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "repair_boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "source_unchanged": {
      "const": true
    },
    "verifier_modified_files": {
      "type": "array",
      "maxItems": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
