{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-residual.invalid/schemas/r2/entangled-causality-v1.schema.json",
  "title": "R2 Entangled Causality",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entanglement_id",
    "positive_effects",
    "negative_effects",
    "observation_angle",
    "rule_responses",
    "permanent_evolution",
    "content_boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entanglement_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "positive_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "negative_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "observation_angle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "rule_responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "permanent_evolution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "content_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "provenance": {
      "$ref": "https://rule-residual.invalid/schemas/r2/rule-semantic-v1.schema.json#/$defs/provenance"
    }
  }
}
