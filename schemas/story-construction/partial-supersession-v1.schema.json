{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rules-residue.invalid/schemas/story-construction/partial-supersession-v1.schema.json",
  "title":"SCG Partial Supersession Manifest",
  "type":"object","additionalProperties":false,
  "required":["schema_version","manifest_id","change_set_id","authority_scope","append_only","historical_records_rewritten","supersession_count","entries","no_other_supersessions"],
  "properties":{
    "schema_version":{"const":"rules-residue.story-construction.partial-supersession/1.0.0"},
    "manifest_id":{"const":"SCG-PRECONTENT-PARTIAL-SUPERSESSION-R1"},
    "change_set_id":{"const":"CS-SCG-PRECONTENT-READINESS-R1-001"},"authority_scope":{"const":"CONSTRUCTION_GOVERNANCE_ONLY"},
    "append_only":{"const":true},"historical_records_rewritten":{"const":false},"supersession_count":{"const":3},
    "entries":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["source_decision_id","disposition","replacement_decision_ids","unaffected_meaning_preserved"],"properties":{"source_decision_id":{"enum":["Q093","Q099","Q129"]},"disposition":{"const":"SUPERSEDED_IN_PART"},"replacement_decision_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^SCG-PRE-Q0(10|11|13|15)$"}},"unaffected_meaning_preserved":{"const":true}}}},
    "no_other_supersessions":{"const":true}
  }
}
