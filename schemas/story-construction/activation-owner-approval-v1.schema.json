{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/activation-owner-approval-v1.schema.json",
  "title": "Story Construction Activation Owner Full-Hash Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "approval_model", "change_set_id", "base_commit",
    "base_tree", "base_canon_hash", "implementation_candidate_commit",
    "implementation_candidate_tree", "implementation_owner_approval_id",
    "implementation_accept_task_id", "implementation_accept_result",
    "implementation_accept_route_digest", "activation_closeout_task_id",
    "activation_candidate_commit", "activation_candidate_tree", "activation_candidate_parent",
    "proposed_canon_hash", "canonical_decisions_hash", "canonical_manifest_hash",
    "previous_governance_merkle_root", "new_activation_merkle_root",
    "changed_merkle_leaves", "final_inner_receipt_path", "final_inner_receipt_file_sha256",
    "final_inner_receipt_payload_hash", "source_package_id", "source_zip_sha256",
    "source_manifest_file_sha256", "source_integrity_defect", "package_sha256",
    "approval_status", "single_use", "transferable", "consumed", "revoked",
    "owner_id", "approved_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_model": {"const": "FULL_ACTIVATION_HASH_SET_REAPPROVAL_REQUIRED"},
    "change_set_id": {"const": "CS-R2-SC-GOV-INSTALL-001"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_canon_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_owner_approval_id": {"type": "string", "minLength": 1},
    "implementation_accept_task_id": {"const": "R2-SC-GOV-INSTALL-001-ACCEPT-001"},
    "implementation_accept_result": {"const": "PASS_FIXED_CANDIDATE_ACCEPTED"},
    "implementation_accept_route_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activation_closeout_task_id": {"const": "R2-SC-GOV-INSTALL-ACTIVATION-CLOSEOUT-IMPLEMENT-001"},
    "activation_candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "activation_candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "activation_candidate_parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposed_canon_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_decisions_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_governance_merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "new_activation_merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_merkle_leaves": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["SCG-AUTHORITY-OVERLAY", "SCG-CANON-REGISTRY", "SCG-SUPERSESSION"]}},
    "final_inner_receipt_path": {"const": "governance/story-construction/receipts/installation-receipt.final.json"},
    "final_inner_receipt_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_inner_receipt_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_package_id": {"const": "RR-SC-GOV-V2-Q001-Q130"},
    "source_zip_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_integrity_defect": {"const": "CIRCULAR_MANIFEST_METADATA_BINDING"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_status": {"enum": ["PENDING_OWNER_ACTIVATION_HASH_APPROVAL", "APPROVED", "REJECTED", "REVOKED"]},
    "single_use": {"const": true},
    "transferable": {"const": false},
    "consumed": {"type": "boolean"},
    "revoked": {"type": "boolean"},
    "owner_id": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]}
  }
}
