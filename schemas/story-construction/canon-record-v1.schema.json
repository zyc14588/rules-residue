{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/canon-record-v1.schema.json",
  "title": "Story Construction Canon Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "revision_id",
    "tier",
    "authority_class",
    "record_type",
    "status",
    "source_ref",
    "dependencies",
    "replaced_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-R[0-9]+$"
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "authority_class": {
      "enum": [
        "P0",
        "P1",
        "C1",
        "C2"
      ]
    },
    "record_type": {
      "enum": [
        "Truth",
        "Event",
        "Rule",
        "Entity",
        "State",
        "Claim",
        "Observation",
        "PublicClaim",
        "Evidence",
        "Hypothesis",
        "Knowledge",
        "Belief",
        "DeceptionIntent",
        "SourceReliability",
        "Confidence",
        "Scene",
        "Route",
        "RevealContract",
        "CanonEnvelope",
        "Asset",
        "TestOracle"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "APPROVED",
        "RELEASED"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "replaced_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
