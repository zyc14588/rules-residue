{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rules-residue.invalid/schemas/story-construction/profile-compatibility-preflight-v1.schema.json",
  "title":"Provider Profile Compatibility Preflight",
  "type":"object","additionalProperties":false,
  "required":["schema_version","preflight_id","provider_id","profile_id","requested_model_alias","resolved_model","provider_revision","actual_fingerprint","expected_configuration_sha256","actual_configuration_sha256","capability_checks","result","checked_at_evidence_id"],
  "properties":{
    "schema_version":{"const":"rules-residue.story-construction.profile-compatibility-preflight/1.0.0"},"preflight_id":{"type":"string","pattern":"^TEST-PREFLIGHT-[A-Z0-9-]+$"},"provider_id":{"enum":["DEEPSEEK-HARNESS","XAI-GROK-CLI"]},"profile_id":{"type":"string","pattern":"^TEST-[A-Z0-9-]+$"},"requested_model_alias":{"type":"string","minLength":1},"resolved_model":{"type":"string","minLength":1},"provider_revision":{"type":"string","minLength":1},"actual_fingerprint":{"type":"string","minLength":1},"expected_configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"actual_configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "capability_checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["capability","expected","actual","match"],"properties":{"capability":{"type":"string","minLength":1},"expected":{"type":"string","minLength":1},"actual":{"type":"string","minLength":1},"match":{"type":"boolean"}}}},"result":{"enum":["COMPATIBLE","INCOMPATIBLE","REVALIDATION_REQUIRED"]},"checked_at_evidence_id":{"type":"string","minLength":1}
  }
}
