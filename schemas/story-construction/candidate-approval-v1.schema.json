{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/candidate-approval-v1.schema.json",
  "title": "Story Construction Candidate Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "change_set_id",
    "base_commit",
    "base_tree",
    "base_canon_hash",
    "candidate_commit",
    "candidate_tree",
    "proposed_canon_hash",
    "merkle_root",
    "receipt_payload_hash",
    "approval_status",
    "single_use",
    "transferable",
    "consumed",
    "revoked",
    "owner_id",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "change_set_id": {
      "const": "CS-R2-SC-GOV-INSTALL-001"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_canon_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "proposed_canon_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "merkle_root": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_payload_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REVOKED"
      ]
    },
    "single_use": {
      "const": true
    },
    "transferable": {
      "const": false
    },
    "consumed": {
      "type": "boolean"
    },
    "revoked": {
      "type": "boolean"
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
