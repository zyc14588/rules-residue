{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/canon-envelope-v1.schema.json",
  "title": "Story Construction Canon Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "tier",
    "t1_refs",
    "t2_refs",
    "allowed_t3_types",
    "forbidden_facts",
    "bounds",
    "owner_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "const": "T3"
    },
    "t1_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "t2_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_t3_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "expires_on_change"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "expires_on_change": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
