{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/dab-v1.schema.json",
  "title": "Story Construction Decision and Audit Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dab_id",
    "tier",
    "subject_ref",
    "decision_refs",
    "approval_refs",
    "generation_refs",
    "validation_refs",
    "repair_refs",
    "waiver_refs",
    "release_refs",
    "private_chain_of_thought_recorded"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dab_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "MINIMAL",
        "STANDARD",
        "FORENSIC"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "generation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "repair_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "waiver_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "release_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "private_chain_of_thought_recorded": {
      "const": false
    }
  }
}
