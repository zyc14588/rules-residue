{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rules-residue:content-safety-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "CONTENT_SAFETY_RECEIPT"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "art_audio",
        "region_acceptance",
        "cross_region_validation",
        "build",
        "release_candidate"
      ]
    },
    "scope_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "SINGLE",
        "INPUT",
        "OUTPUT"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory_member"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "input_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory_member"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "output_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "REJECT",
        "BLOCKED"
      ]
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "not_before": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "receipt_id",
    "namespace",
    "execution_id",
    "task_id",
    "occurrence_id",
    "stage",
    "scope_digest",
    "phase",
    "source",
    "authority",
    "review",
    "inputs",
    "input_root",
    "outputs",
    "output_root",
    "decision",
    "issued_at",
    "not_before",
    "expires_at"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]{0,239}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "path",
        "sha256",
        "revision"
      ]
    },
    "inventory_member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]{0,239}$"
        },
        "kind": {
          "const": "regular_file"
        },
        "mode": {
          "type": "string",
          "enum": [
            "100644",
            "100755"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "kind",
        "mode",
        "bytes",
        "sha256"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "game_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "game_tree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "consumer_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "game_commit",
        "game_tree",
        "consumer_sha256",
        "schema_sha256",
        "policy_sha256",
        "input_root"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "consumer_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "schema_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "namespace",
        "checkpoint",
        "revocation_epoch",
        "policy_revision",
        "consumer_revision",
        "schema_revision"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer_task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "producer_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reviewer_task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "reviewer_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "report_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "producer_task",
        "producer_run",
        "reviewer_task",
        "reviewer_run",
        "report_sha256",
        "manifest_sha256"
      ]
    },
    "audio_intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "media_kind": {
          "const": "audio"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "wav": {
          "$ref": "#/$defs/reference"
        },
        "encoding": {
          "const": "PCM_S16LE"
        },
        "channels": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            44100,
            48000
          ]
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880000
        },
        "source": {
          "$ref": "#/$defs/reference"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "accessibility": {
          "$ref": "#/$defs/reference"
        },
        "transcript_status": {
          "type": "string",
          "enum": [
            "PRESENT",
            "EXPLICITLY_ABSENT"
          ]
        },
        "transcripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "schema_version",
        "media_kind",
        "asset_id",
        "task_id",
        "use",
        "wav",
        "encoding",
        "channels",
        "sample_rate",
        "frames",
        "source",
        "author",
        "rights",
        "accessibility",
        "transcript_status",
        "transcripts",
        "attachments"
      ]
    },
    "custody_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]{0,239}$"
        },
        "blob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "commit",
        "tree",
        "path",
        "blob"
      ]
    },
    "authority_statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "CONTENT_SAFETY_ACCEPTANCE_STATEMENT"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "receipt_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "producer_task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "reviewer_task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "producer_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reviewer_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "REJECT",
            "BLOCKED"
          ]
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "schema_version",
        "kind",
        "namespace",
        "receipt_sha256",
        "report_sha256",
        "manifest_sha256",
        "producer_task",
        "reviewer_task",
        "producer_run",
        "reviewer_run",
        "decision",
        "checkpoint",
        "revocation_epoch"
      ]
    }
  }
}
