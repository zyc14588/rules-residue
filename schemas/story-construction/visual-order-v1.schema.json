{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/visual-order-v1.schema.json",
  "title": "Story Construction Visual Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "order_id",
    "order_authority",
    "task_type",
    "semantic_composition_proof",
    "canon_refs",
    "dossier_refs",
    "must_objects",
    "forbidden_objects",
    "spatial_relations",
    "salience",
    "occlusion",
    "state_continuity",
    "reveal_refs",
    "accessibility_equivalent",
    "rights_provenance",
    "capability_declaration",
    "proposed_fact_classes",
    "order_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "order_id": {
      "type": "string",
      "pattern": "^VISUAL-ORDER-[A-Z0-9-]+$"
    },
    "order_authority": {
      "const": "VALIDATED_VISUAL_ORDER_PACKAGE"
    },
    "task_type": {
      "const": "art"
    },
    "semantic_composition_proof": {
      "type": "string",
      "minLength": 1
    },
    "canon_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dossier_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "must_objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "spatial_relations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "salience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "occlusion": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state_continuity": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reveal_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accessibility_equivalent": {
      "type": "string",
      "minLength": 1
    },
    "rights_provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capability_declaration": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proposed_fact_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "order_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
