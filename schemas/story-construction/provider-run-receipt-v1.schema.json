{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rules-residue.invalid/schemas/story-construction/provider-run-receipt-v1.schema.json",
  "title":"Provider Run Receipt",
  "type":"object","additionalProperties":false,
  "required":["schema_version","run_id","profile_id","provider_id","evidence_kind","requested_model_alias","resolved_model","provider_revision","actual_fingerprint","identity_assurance","adapter_identity","configuration_sha256","policy_evidence_id","policy_evidence_date","data_control_evidence","jurisdiction_evidence","input_sha256","order_sha256","context_manifest_sha256","output_sha256","source_license_provenance","rights_obligations","rights_status","release_eligible","cost_recorded","latency_recorded","quality_gate_adjusted_for_cost_or_latency","private_chain_of_thought_recorded","secrets_recorded","receipt_payload_hash"],
  "properties":{
    "schema_version":{"const":"rules-residue.story-construction.provider-run-receipt/1.0.0"},"run_id":{"type":"string","pattern":"^TEST-RUN-[A-Z0-9-]+$"},"profile_id":{"type":"string","pattern":"^TEST-[A-Z0-9-]+$"},"provider_id":{"enum":["DEEPSEEK-HARNESS","XAI-GROK-CLI"]},"evidence_kind":{"const":"REAL_PROVIDER_EXECUTION"},
    "requested_model_alias":{"type":"string","minLength":1},"resolved_model":{"type":"string","minLength":1},"provider_revision":{"type":"string","minLength":1},"actual_fingerprint":{"type":"string","minLength":1},"identity_assurance":{"enum":["RESOLVED_AND_FINGERPRINTED","RESOLVED_PROVIDER_ASSERTED"]},"adapter_identity":{"type":"string","minLength":1},"configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_evidence_id":{"type":"string","minLength":1},"policy_evidence_date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"data_control_evidence":{"type":"string","minLength":1},"jurisdiction_evidence":{"type":"string","minLength":1},
    "input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"order_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"context_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"output_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_license_provenance":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"rights_obligations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"rights_status":{"const":"RIGHTS_PENDING"},"release_eligible":{"const":false},
    "cost_recorded":{"const":true},"latency_recorded":{"const":true},"quality_gate_adjusted_for_cost_or_latency":{"const":false},"private_chain_of_thought_recorded":{"const":false},"secrets_recorded":{"const":false},"receipt_payload_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
