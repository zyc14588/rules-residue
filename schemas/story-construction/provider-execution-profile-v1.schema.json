{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rules-residue.invalid/schemas/story-construction/provider-execution-profile-v1.schema.json",
  "title":"Provider Execution Profile",
  "type":"object","additionalProperties":false,
  "required":["schema_version","profile_id","provider_id","certificate_subject","requested_model_alias","modality","configuration","configuration_sha256","authorization_batch","authorization_status","certification_status","data_boundary"],
  "properties":{
    "schema_version":{"const":"rules-residue.story-construction.provider-execution-profile/1.0.0"},"profile_id":{"type":"string","pattern":"^TEST-[A-Z0-9-]+$"},"provider_id":{"enum":["DEEPSEEK-HARNESS","XAI-GROK-CLI"]},"certificate_subject":{"const":"PROVIDER"},"requested_model_alias":{"type":"string","minLength":1},"modality":{"enum":["TEXT","IMAGE"]},
    "configuration":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string","minLength":1},"value":{"type":"string","minLength":1}}}},"configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authorization_batch":{"const":"M3-B002"},"authorization_status":{"const":"CONTRACT_ONLY_NO_CALL"},"certification_status":{"const":"NOT_CERTIFIED"},"data_boundary":{"const":"SYNTHETIC_SCG_M0_TEST_ONLY"}
  }
}
