{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rules-residue.invalid/schemas/story-construction/m2-dependency-classification-v1.schema.json",
  "title":"M2 Capability-Domain Dependency Classification",
  "type":"object","additionalProperties":false,
  "required":["schema_version","classification_id","subject_id","namespace_prefix","canon","release_eligible","promotion_allowed","disposition","algorithm","dependency_tags","blocker_catalog","closure_proofs","computed_affected_blockers","result"],
  "properties":{
    "schema_version":{"const":"rules-residue.story-construction.m2-dependency-classification/1.0.0"},"classification_id":{"type":"string","pattern":"^TEST-M2-DEPENDENCY-[A-Z0-9-]+$"},"subject_id":{"type":"string","pattern":"^TEST-[A-Z0-9-]+$"},
    "namespace_prefix":{"const":"TEST-"},"canon":{"const":false},"release_eligible":{"const":false},"promotion_allowed":{"const":false},"disposition":{"const":"TEST_EVIDENCE_ONLY"},"algorithm":{"const":"TAG_INTERSECTION_WITH_PROOF_CLOSURE_V1"},
    "dependency_tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "blocker_catalog":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"enum":["R2-INT-011","R2-INT-012","DEFER-R2-C14-001"]}},
    "closure_proofs":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["blocker_id","required_tags","intersection","proof_ref"],"properties":{"blocker_id":{"enum":["R2-INT-011","R2-INT-012","DEFER-R2-C14-001"]},"required_tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"intersection":{"type":"array","maxItems":0,"items":{"type":"string"}},"proof_ref":{"type":"string","minLength":1}}}},
    "computed_affected_blockers":{"type":"array","maxItems":0,"items":{"type":"string"}},"result":{"const":"INDEPENDENT_OF_CURRENT_M2_BLOCKERS"}
  }
}
