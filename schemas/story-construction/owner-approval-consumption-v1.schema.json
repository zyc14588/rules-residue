    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposed_canon_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_candidate_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval": {"const": "OWNER_HASH_APPROVED_FOR_INDEPENDENT_ACCEPT"},
    "single_use": {"const": true},
    "transferable": {"const": false},
    "revoked": {"const": false},
    "consumption_count": {"const": 1},
    "consumption_event": {"const": "R2-SC-GOV-INSTALL-001-ACCEPT-001"},
    "consumption_result": {"const": "PASS_FIXED_CANDIDATE_ACCEPTED"},
    "accepted_candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accepted_candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accept_route_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
