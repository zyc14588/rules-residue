{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/owner-approval-consumption-v1.schema.json",
  "title": "Story Construction Owner Approval Consumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
