  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"const": "OWNER-APPROVAL-R2-SC-GOV-INSTALL-001-CANDIDATE-7305A9DE-R1"},
    "change_set_id": {"const": "CS-R2-SC-GOV-INSTALL-001"},
