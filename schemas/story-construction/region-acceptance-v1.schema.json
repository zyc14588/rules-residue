{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-residue.invalid/schemas/story-construction/region-acceptance-v1.schema.json",
  "title": "Story Construction Region Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "dossier_ref",
    "dab_ref",
    "validation_layers",
    "defects",
    "result",
    "owner_approvals",
    "candidate_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "dossier_ref": {
      "type": "string",
      "minLength": 1
    },
    "dab_ref": {
      "type": "string",
      "minLength": 1
    },
    "validation_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "V0",
        "V1",
        "V2",
        "V3",
        "V4",
        "V5",
        "V6"
      ],
      "properties": {
        "V0": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V1": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V2": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V3": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V4": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V5": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "V6": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_id",
          "severity",
          "status"
        ],
        "properties": {
          "defect_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "COSMETIC"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "FIXED",
              "WAIVED"
            ]
          }
        }
      }
    },
    "result": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "owner_approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidate_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
