{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed native action, lifecycle and legal-actions results",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ACTION_RESULT"
        },
        "action": {
          "enum": [
            "PUBLISH_TASK",
            "ACCEPT_TASK",
            "REFUSE_TASK",
            "WITHDRAW_TASK",
            "SUBMIT_OBSERVATION",
            "ADJUDICATE_TASK",
            "SETTLE_TASK",
            "WRITE_OWN_PAPER",
            "SHARE_SOURCE",
            "WATCH"
          ]
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "NEEDS_EVIDENCE",
            "SETTLED",
            "REPLAYED"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "INVALID_PAYLOAD",
            "INVALID_SOURCE",
            "UNAUTHORIZED_SEAT",
            "WRONG_PHASE",
            "UNSUPPORTED_ACTION",
            "PREFIX_BOUNDARY",
            "MISSING_PERSONAL_INSPECTION",
            "MISSING_SHARED_OBSERVATION",
            "MISSING_SUBMISSION",
            "NOT_ADJUDICATED",
            "NO_STOCK",
            "NOT_PAPER_HOLDER"
          ]
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "tick_delta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "event_ids": {
          "$ref": "#/$defs/_unique_0"
        },
        "settlement_receipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "receipt_id": {
                  "$ref": "#/$defs/_identifier"
                },
                "transfer_event_id": {
                  "$ref": "#/$defs/_event_id"
                },
                "opening_seat_id": {
                  "$ref": "#/$defs/_identifier"
                },
                "paper_id": {
                  "$ref": "#/$defs/_identifier"
                },
                "item_id": {
                  "const": "TEST_ONLY.tutorial.ordinary_record_sheet"
                },
                "quantity": {
                  "const": 1
                },
                "issuer": {
                  "const": "npc.lin-que"
                },
                "recipient_seat_id": {
                  "$ref": "#/$defs/_identifier"
                },
                "statement": {
                  "const": "NPC_ACCEPTED_AND_TRANSFERRED"
                }
              },
              "required": [
                "receipt_id",
                "transfer_event_id",
                "opening_seat_id",
                "paper_id",
                "item_id",
                "quantity",
                "issuer",
                "recipient_seat_id",
                "statement"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "action",
        "status",
        "reason",
        "tick",
        "tick_delta",
        "event_ids",
        "settlement_receipt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "LIFECYCLE_RESULT"
        },
        "callback": {
          "enum": [
            "on_session_create",
            "on_session_restore",
            "on_session_start",
            "restore_checkpoint",
            "resume_continuation",
            "on_safe_migration_boundary",
            "on_session_end",
            "cleanup"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "READY",
            "RESTORED",
            "PAUSED",
            "CLEANED",
            "UNSUPPORTED"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "CONTINUATION_NOT_SUPPORTED"
          ]
        }
      },
      "required": [
        "kind",
        "callback",
        "schema_version",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "LEGAL_ACTIONS"
        },
        "actions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "PUBLISH_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "ACCEPT_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "REFUSE_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "WITHDRAW_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "ADJUDICATE_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "SETTLE_TASK"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  }
                },
                "required": [
                  "action",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "WATCH"
                  },
                  "target": {
                    "const": "target.departure_board"
                  }
                },
                "required": [
                  "action",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "SUBMIT_OBSERVATION"
                  },
                  "task_id": {
                    "const": "TASK.TEST.CLOCK_OBSERVATION.V1"
                  },
                  "observation_event_id": {
                    "$ref": "#/$defs/_event_id"
                  },
                  "recipient": {
                    "const": "npc.lin-que"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "action",
                  "task_id",
                  "observation_event_id",
                  "recipient",
                  "description"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "WRITE_OWN_PAPER"
                  },
                  "paper_id": {
                    "$ref": "#/$defs/_identifier"
                  },
                  "source_event_id": {
                    "$ref": "#/$defs/_event_id"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "action",
                  "paper_id",
                  "source_event_id",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "SHARE_SOURCE"
                  },
                  "source_event_id": {
                    "$ref": "#/$defs/_event_id"
                  },
                  "recipient_seat_ids": {
                    "$ref": "#/$defs/_unique_1"
                  },
                  "record_kind": {
                    "enum": [
                      "RAW_OBSERVATION",
                      "PLAYER_CLAIM",
                      "PAPER_TEXT"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "action",
                  "source_event_id",
                  "recipient_seat_ids",
                  "record_kind",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "kind",
        "actions"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "_event_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^evt-[0-9a-f]+$"
    },
    "_unique_0": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/_event_id"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "_unique_1": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/_identifier"
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    }
  }
}
